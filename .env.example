# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env (déjà exclu par .gitignore).

# --- PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astrolearn_db

# --- MongoDB (commentaires) ---
# Par défaut mongodb://localhost:27017 ; avec Docker : mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=astrolearn_nosql

# --- Flask ---
# Clé secrète pour la signature des sessions. Générer avec :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Compte admin créé au premier démarrage (optionnel) ---
# Si l'une de ces trois variables est absente, aucun admin n'est créé automatiquement.
ADMIN_PSEUDO=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NOM=Admin
ADMIN_PRENOM=Super

# --- APIs externes ---
GEMINI_API_KEY=
